::kind(catasto, version: "1.0.0")
::upstream(
  commonfiles:  catasto.git("https://github.com/tomet-lang/commonfiles.git", rev: main, root: base)
  vocabularies: catasto.git("https://github.com/tomet-lang/vocabularies.git", rev: main, root: vocabularies)
  fs_catasto:   catasto.git("https://github.com/tomet-lang/fs-catasto.git", rev: "main", root: "tmtroot/schema")
)

// --- Tomet ---
"tmtroot/dev/agent/behavior.tmt":          catasto.upstream(commonfiles, path: "tmtroot/dev/agent/behavior.tmt")
"tmtroot/dev/agent/commit-policy.tmt":     catasto.upstream(commonfiles, path: "tmtroot/dev/agent/commit-policy.tmt")
"tmtroot/dev/agent/task.tmt":              catasto.upstream(commonfiles, path: "tmtroot/dev/agent/task.tmt")
"tmtroot/dev/agent/writ.tmt":              catasto.upstream(commonfiles, path: "tmtroot/dev/agent/writ.tmt")
"tmtroot/dev/convention/code-comment.tmt": catasto.upstream(commonfiles, path: "tmtroot/dev/convention/code-comment.tmt")
"tmtroot/dev/convention/commit.tmt":       catasto.upstream(commonfiles, path: "tmtroot/dev/convention/commit.tmt")
"tmtroot/dev/convention/document.tmt":     catasto.upstream(commonfiles, path: "tmtroot/dev/convention/document.tmt")
"tmtroot/dev/convention/principles.tmt":   catasto.upstream(commonfiles, path: "tmtroot/dev/convention/principles.tmt")
"tmtroot/dev/howto/jj.tmt":                catasto.upstream(commonfiles, path: "tmtroot/dev/howto/jj.tmt")
"tmtroot/dev/howto/nix.tmt":               catasto.upstream(commonfiles, path: "tmtroot/dev/howto/nix.tmt")

// --- Schema ---
"tmtroot/schema/catasto@1.0.0.vocabulary.tmt": catasto.upstream(fs_catasto, path: "catasto@1.0.0.vocabulary.tmt")
"tmtroot/schema/catasto@1.0.0.blueprint.ctmt": catasto.upstream(fs_catasto, path: "catasto@1.0.0.blueprint.ctmt")
"tmtroot/schema/rust@1.0.0.vocabulary.tmt":    catasto.upstream(vocabularies, path: "rust/rust@1.0.0.vocabulary.tmt")
"tmtroot/schema/writ@1.0.0.vocabulary.tmt":    catasto.upstream(vocabularies, path: "writ/writ@1.0.0.vocabulary.tmt")

// --- Environment ---
".editorconfig":  catasto.upstream(commonfiles, path: ".editorconfig")
".envrc":         catasto.upstream(commonfiles, path: ".envrc")
".gitattributes": catasto.upstream(commonfiles, path: ".gitattributes")
"LICENSE-APACHE": catasto.upstream(commonfiles, path: "LICENSE-APACHE")
"LICENSE-MIT":    catasto.upstream(commonfiles, path: "LICENSE-MIT")

// --- Vendor Config ---
"nix/formatter.nix": catasto.upstream(commonfiles, path: "nix/formatter.nix")
