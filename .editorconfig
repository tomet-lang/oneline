root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}]
indent_style = space
indent_size = 2

[*.{json,yaml,yml,toml,nix}]
indent_style = space
indent_size = 2

[*.{sh,bash,zsh,fish}]
indent_style = space
indent_size = 2

[*.{md,tmt}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
