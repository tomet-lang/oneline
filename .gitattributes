# Normalize all text files to LF line endings
* text=auto eol=lf

#= Linguist
tmtroot/ linguist-documentation=true
docs/ linguist-documentation=true
*.md linguist-language=Markdown
*.tmt linguist-language=Tomet

# Written by `tomet export` from the documents under tmtroot/, not by hand.
/AGENTS.md linguist-generated=true
/README.md linguist-generated=true
/CONTRIBUTING.md linguist-generated=true
/CLAUDE.md linguist-generated=true

# Frozen test inputs, deliberately not kept in step with the documents.
tests/fixtures/ linguist-vendored=true

#= Git LFS
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.ico filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.woff2 filter=lfs diff=lfs merge=lfs -text
